#!/usr/bin/env bash
# `php` is often absent from a non-interactive shell's PATH even when it is installed, so
# `pnpm check` dies with `env: php: No such file or directory` while pnpm itself works —
# which reads as a broken install rather than a shell that cannot see the binary.
#
# This only ever reports; it never edits PATH for you, and it hardcodes nothing as "the"
# location. If it cannot find a PHP it says so plainly and gets out of the way.
set -euo pipefail

if command -v php >/dev/null 2>&1; then
    exit 0
fi

echo "php is not on PATH, so this script cannot run." >&2

# Common per-user and system locations, in no particular order of authority — Herd (macOS),
# Lerd (Linux, see .lerd.yaml), Homebrew, and the system paths. A candidate is only mentioned
# if a PHP executable is actually there on THIS machine, so an entry that does not match this
# setup costs nothing and a wrong guess can never mislead.
for candidate in \
    "$HOME/Library/Application Support/Herd/bin" \
    "$HOME/.config/herd-lite/bin" \
    "$HOME/.lerd/bin" \
    "$HOME/.config/lerd/bin" \
    /opt/lerd/bin \
    "$HOME/.local/bin" \
    /opt/homebrew/bin \
    /usr/local/bin \
    /usr/bin
do
    if [ -x "$candidate/php" ]; then
        echo "Found one at $candidate — put it on PATH first:" >&2
        echo "" >&2
        echo "    export PATH=\"$candidate:\$PATH\"" >&2
        exit 1
    fi
done

echo "No PHP found in the usual places. Install PHP 8.4+, or activate whatever" >&2
echo "manages it here (Herd, Lerd, Homebrew, asdf, mise, a container shell), then retry." >&2
exit 1
