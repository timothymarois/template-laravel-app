#!/usr/bin/env bash

set -euo pipefail

fail() {
    echo "Release version refused: $1" >&2
    exit 1
}

repository_root="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "run this inside the repository"
cd "$repository_root"

command -v python3 >/dev/null 2>&1 || fail "python3 is required"

python3 <<'PY'
import json
import re
from pathlib import Path

versions = {}

for filename in ("composer.json", "package.json"):
    path = Path(filename)
    if not path.is_file():
        raise SystemExit(f"Release version refused: {filename} is missing")

    try:
        version = json.loads(path.read_text())["version"]
    except (json.JSONDecodeError, KeyError, TypeError):
        raise SystemExit(f"Release version refused: {filename} has no valid version")

    if not isinstance(version, str) or re.fullmatch(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)", version) is None:
        raise SystemExit(f"Release version refused: {filename} must use strict MAJOR.MINOR.PATCH syntax")

    versions[filename] = version

if len(set(versions.values())) != 1:
    raise SystemExit("Release version refused: composer.json and package.json versions disagree")

version = versions["composer.json"]
if version == "0.0.0":
    raise SystemExit("Release version refused: 0.0.0 is not a production release")

print(f"version={version}")
print(f"tag=v{version}")
PY
