{
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "php artisan ziggy:generate && vite",
    "build": "php artisan ziggy:generate && vite build",
    "build-ssr": "php artisan ziggy:generate && vite build && vite build --ssr",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"resources/js/**/*.{js,vue}\"",
    "lint:fix": "eslint \"resources/js/**/*.{js,vue}\" --fix",
    "lint:css": "stylelint \"resources/css/**/*.css\"",
    "lint:css:fix": "stylelint \"resources/css/**/*.css\" --fix",
    "check:php": "./vendor/bin/pint --test && ./vendor/bin/phpstan analyse --memory-limit=512M && php -d memory_limit=512M ./vendor/bin/pest",
    "check:tenancy": "php -d memory_limit=512M ./vendor/bin/pest --configuration=phpunit.tenancy.xml",
    "check:js": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test",
    "check:build": "pnpm build && pnpm exec vite build --ssr",
    "check": "concurrently -g \"pnpm check:php\" \"pnpm check:js\" && pnpm check:build",
    "check:all": "pnpm check && pnpm check:tenancy"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.2.0",
    "@stylistic/stylelint-plugin": "^4.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/server-renderer": "^3.5.34",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "laravel-vite-plugin": "^2.1.0",
    "lodash": "^4.18.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.8",
    "vite": "^7.3.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.1.8"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@sentry/vue": "^10.53.1",
    "@tabler/icons-vue": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/extension-document": "^3.23.6",
    "@tiptap/extension-hard-break": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-paragraph": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-text": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/vue-3": "^3.23.6",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "highlight.js": "^11.11.1",
    "laravel-echo": "^2.3.4",
    "lucide-vue-next": "^0.562.0",
    "maska": "^3.2.0",
    "pusher-js": "^8.5.0",
    "qs-esm": "^8.0.1",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-draggable-plus": "^0.6.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-sonner": "^2.0.9"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
      "yaml": ">=2.8.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi",
      "maplibre-gl"
    ]
  }
}
