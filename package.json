{
    "private": true,
    "type": "module",
    "version": "0.0.0",
    "packageManager": "pnpm@10.20.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "php artisan ziggy:generate && vite",
        "build": "php artisan ziggy:generate && vite build",
        "build-ssr": "php artisan ziggy:generate && vite build && vite build --ssr",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint \"resources/js/**/*.{js,ts,vue}\"",
        "lint:fix": "eslint \"resources/js/**/*.{js,ts,vue}\" --fix",
        "lint:css": "stylelint \"resources/css/**/*.css\"",
        "lint:css:fix": "stylelint \"resources/css/**/*.css\" --fix",
        "check:php": "./vendor/bin/pint --test && ./vendor/bin/phpstan analyse --memory-limit=512M && php -d memory_limit=512M ./vendor/bin/pest",
        "check:js": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test",
        "check:release": "bash tests/scripts/prepare-production-release.sh && bash tests/scripts/production-release-version.sh && bash tests/scripts/publish-production-release.sh && bash tests/scripts/assert-neutral-main-version.sh",
        "check:deploy": "bash tests/scripts/php-ini.sh && bash tests/scripts/nginx-config.sh && bash tests/scripts/post-deployment.sh",
        "check:build": "pnpm build && pnpm exec vite build --ssr",
        "check": "concurrently -g \"pnpm check:php\" \"pnpm check:js\" \"pnpm check:release\" \"pnpm check:deploy\" && pnpm check:build"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.7.0",
        "@stylistic/stylelint-plugin": "^4.0.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tiptap/core": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@types/node": "^25.9.5",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/server-renderer": "^3.5.42",
        "@vue/test-utils": "^2.5.0",
        "@vueuse/core": "^14.4.0",
        "autoprefixer": "^10.5.5",
        "axios": "^1.20.0",
        "concurrently": "^9.2.4",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.11.0",
        "happy-dom": "^20.14.0",
        "laravel-vite-plugin": "^2.1.0",
        "lodash": "^4.18.1",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^39.0.1",
        "typescript": "^5.9.3",
        "unplugin-auto-import": "^0.17.8",
        "vite": "^7.3.6",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@sentry/vue": "^10.73.0",
        "@tabler/icons-vue": "^3.46.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/vue-table": "^8.21.3",
        "@tiptap/extension-document": "^3.31.3",
        "@tiptap/extension-hard-break": "^3.31.3",
        "@tiptap/extension-link": "^3.31.3",
        "@tiptap/extension-paragraph": "^3.31.3",
        "@tiptap/extension-placeholder": "^3.31.3",
        "@tiptap/extension-text": "^3.31.3",
        "@tiptap/extension-underline": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "@tiptap/vue-3": "^3.31.3",
        "@unovis/ts": "^1.6.7",
        "@unovis/vue": "^1.6.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-vue": "^8.6.0",
        "highlight.js": "^11.12.0",
        "laravel-echo": "^2.5.0",
        "lucide-vue-next": "^0.562.0",
        "maska": "^3.2.1",
        "pusher-js": "^8.6.0",
        "qs-esm": "^8.0.1",
        "radix-vue": "^1.9.17",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.42",
        "vue-draggable-plus": "^0.6.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-sonner": "^2.0.9"
    },
    "pnpm": {
        "overrides": {
            "shell-quote": ">=1.8.4",
            "yaml": ">=2.8.3"
        },
        "onlyBuiltDependencies": [
            "esbuild",
            "vue-demi",
            "maplibre-gl"
        ]
    }
}
