{
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "php artisan ziggy:generate && vite",
    "build": "php artisan ziggy:generate && vite build",
    "build-ssr": "php artisan ziggy:generate && vite build && vite build --ssr",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"resources/js/**/*.{js,vue}\"",
    "lint:fix": "eslint \"resources/js/**/*.{js,vue}\" --fix",
    "lint:css": "stylelint \"resources/css/**/*.css\"",
    "lint:css:fix": "stylelint \"resources/css/**/*.css\" --fix",
    "check:php": "./vendor/bin/pint --test && ./vendor/bin/phpstan analyse --memory-limit=512M && php -d memory_limit=512M ./vendor/bin/pest",
    "check:js": "pnpm lint && pnpm lint:css && pnpm test",
    "check:docs": "pnpm docs:lint && pnpm docs:lint:css",
    "check:build": "pnpm build && pnpm exec vite build --ssr && pnpm docs:build",
    "check": "concurrently -g \"pnpm:check:php\" \"pnpm:check:js\" \"pnpm:check:docs\" && pnpm check:build",
    "docs:dev": "cd docs && pnpm dev",
    "docs:build": "cd docs && pnpm build",
    "docs:lint": "cd docs && pnpm lint",
    "docs:lint:fix": "cd docs && pnpm lint:fix",
    "docs:lint:css": "cd docs && pnpm lint:css",
    "docs:lint:css:fix": "cd docs && pnpm lint:css:fix",
    "docs:check": "cd docs && pnpm check"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^2.3.13",
    "@stylistic/stylelint-plugin": "^4.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@types/node": "^25.2.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/server-renderer": "^3.5.27",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.2.0",
    "autoprefixer": "^10.4.24",
    "axios": "^1.13.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "happy-dom": "^20.4.0",
    "laravel-vite-plugin": "^2.1.0",
    "lodash": "^4.17.23",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.8",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.1",
    "@sentry/vue": "^10.38.0",
    "@tabler/icons-vue": "^3.36.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/extension-document": "^3.18.0",
    "@tiptap/extension-hard-break": "^3.18.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/extension-paragraph": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/extension-text": "^3.18.0",
    "@tiptap/extension-underline": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@tiptap/vue-3": "^3.18.0",
    "@unovis/ts": "^1.6.4",
    "@unovis/vue": "^1.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "highlight.js": "^11.11.1",
    "laravel-echo": "^2.3.0",
    "lucide-vue-next": "^0.562.0",
    "maska": "^3.2.0",
    "pusher-js": "^8.4.0",
    "qs-esm": "^8.0.1",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.27",
    "vue-eslint-parser": "^10.2.0",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi",
      "maplibre-gl"
    ]
  }
}
