<?php

declare(strict_types=1);

namespace App\Providers;

use Illuminate\Support\ServiceProvider;

class ElectronServiceProvider extends ServiceProvider
{
    /**
     * Register any application services.
     */
    public function register(): void
    {
        // Register electron-specific bindings
    }

    /**
     * Bootstrap any application services.
     */
    public function boot(): void
    {
        // Configure storage paths for Electron runtime
        if ($this->isElectronRuntime()) {
            $this->configureElectronPaths();
        }
    }

    /**
     * Determine if the application is running in Electron.
     */
    protected function isElectronRuntime(): bool
    {
        // APP_STORAGE_PATH is set by the Electron boot manager
        return env('APP_STORAGE_PATH') !== null;
    }

    /**
     * Configure paths for Electron runtime.
     */
    protected function configureElectronPaths(): void
    {
        $storagePath = env('APP_STORAGE_PATH');

        if ($storagePath) {
            $this->app->useStoragePath($storagePath);
        }
    }
}
