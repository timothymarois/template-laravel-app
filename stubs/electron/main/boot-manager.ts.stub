import * as fs from 'fs';
import * as path from 'path';
import {
    ConfigService,
    PortService,
    ProcessService,
    LaravelService,
    HealthService,
} from './services';

// Optional services - imported conditionally at runtime
// These files may not exist depending on build:electron configuration
// Using 'any' type to avoid compile-time dependency on optional service files
let RedisService: any;
let HorizonService: any;
let ReverbService: any;
let SchedulerService: any;

try { RedisService = require('./services/redis-service').RedisService; } catch {}
try { HorizonService = require('./services/horizon-service').HorizonService; } catch {}
try { ReverbService = require('./services/reverb-service').ReverbService; } catch {}
try { SchedulerService = require('./services/scheduler-service').SchedulerService; } catch {}

interface BootManagerOptions {
    isDev: boolean;
    onStatusUpdate: (status: string, progress: number) => void;
    onError: (error: string) => void;
}

interface ElectronConfig {
    services: {
        database: { driver: string; external: boolean };
        redis: { enabled: boolean; external: boolean };
        horizon: { enabled: boolean };
        reverb: { enabled: boolean };
        scheduler: { enabled: boolean };
    };
    ports: {
        laravel: number;
        redis: number;
        reverb: number;
    };
}

export class BootManager {
    private options: BootManagerOptions;
    private config: ElectronConfig;

    // Services
    private configService: ConfigService;
    private portService: PortService;
    private processService: ProcessService;
    private laravelService: LaravelService;
    private healthService: HealthService;
    // Optional services use 'any' to avoid compile-time dependency on optional service files
    private redisService?: any;
    private horizonService?: any;
    private reverbService?: any;
    private schedulerService?: any;

    // Ports
    private laravelPort: number;
    private redisPort: number;
    private reverbPort: number;

    constructor(options: BootManagerOptions) {
        this.options = options;

        // Load electron config
        this.config = this.loadConfig();

        // Set default ports from config
        this.laravelPort = this.config.ports.laravel;
        this.redisPort = this.config.ports.redis;
        this.reverbPort = this.config.ports.reverb;

        // Initialize core services
        this.configService = new ConfigService({ isDev: options.isDev });
        this.portService = new PortService();
        this.processService = new ProcessService({
            pidFilePath: this.configService.pidFilePath,
            onError: options.onError,
        });
        this.laravelService = new LaravelService({
            configService: this.configService,
            processService: this.processService,
        });
        this.healthService = new HealthService();

        // Initialize optional services based on config
        if (this.config.services.redis.enabled && RedisService) {
            this.redisService = new RedisService({
                configService: this.configService,
                processService: this.processService,
            });
        }

        if (this.config.services.horizon.enabled && HorizonService && this.redisService) {
            this.horizonService = new HorizonService({
                configService: this.configService,
                processService: this.processService,
                redisService: this.redisService,
            });
        }

        if (this.config.services.reverb.enabled && ReverbService) {
            this.reverbService = new ReverbService({
                configService: this.configService,
                processService: this.processService,
            });
        }

        if (this.config.services.scheduler.enabled && SchedulerService) {
            this.schedulerService = new SchedulerService({
                configService: this.configService,
                processService: this.processService,
            });
        }
    }

    private loadConfig(): ElectronConfig {
        // Default config
        const defaultConfig: ElectronConfig = {
            services: {
                database: { driver: 'sqlite', external: false },
                redis: { enabled: true, external: false },
                horizon: { enabled: true },
                reverb: { enabled: false },
                scheduler: { enabled: false },
            },
            ports: {
                laravel: 48000,
                redis: 6379,
                reverb: 48080,
            },
        };

        // Try to load from Laravel config (via env or config file)
        // In production, config is embedded; in dev, read from env
        return {
            services: {
                database: {
                    driver: process.env.ELECTRON_DB_DRIVER || defaultConfig.services.database.driver,
                    external: process.env.ELECTRON_DB_EXTERNAL === 'true',
                },
                redis: {
                    enabled: process.env.ELECTRON_REDIS_ENABLED !== 'false',
                    external: process.env.ELECTRON_REDIS_EXTERNAL === 'true',
                },
                horizon: {
                    enabled: process.env.ELECTRON_HORIZON_ENABLED !== 'false',
                },
                reverb: {
                    enabled: process.env.ELECTRON_REVERB_ENABLED === 'true',
                },
                scheduler: {
                    enabled: process.env.ELECTRON_SCHEDULER_ENABLED === 'true',
                },
            },
            ports: {
                laravel: parseInt(process.env.ELECTRON_PORT_LARAVEL || String(defaultConfig.ports.laravel)),
                redis: parseInt(process.env.ELECTRON_PORT_REDIS || String(defaultConfig.ports.redis)),
                reverb: parseInt(process.env.ELECTRON_PORT_REVERB || String(defaultConfig.ports.reverb)),
            },
        };
    }

    async boot(): Promise<string> {
        try {
            // Step 0: Initialize directories
            console.log('[Boot] Step 0: Initializing directories...');
            this.options.onStatusUpdate('Initializing...', 5);
            this.configService.initializeDirectories();

            // Step 1: Clean up stale processes
            console.log('[Boot] Step 1: Cleaning up stale processes...');
            this.options.onStatusUpdate('Cleaning up...', 10);
            await this.processService.cleanupStaleProcesses();

            // Step 2: Check database and run migrations
            console.log('[Boot] Step 2: Checking database...');
            this.options.onStatusUpdate('Checking database...', 15);
            await this.checkDatabase();

            // Step 3: Find available ports
            console.log('[Boot] Step 3: Finding available ports...');
            this.options.onStatusUpdate('Allocating ports...', 20);
            this.laravelPort = await this.portService.findAvailablePort(this.config.ports.laravel);

            if (this.config.services.redis.enabled && !this.config.services.redis.external) {
                this.redisPort = await this.portService.findAvailablePort(this.config.ports.redis);
            }

            if (this.config.services.reverb.enabled) {
                this.reverbPort = await this.portService.findAvailablePort(this.config.ports.reverb);
            }

            console.log(`[Boot] Ports - Laravel: ${this.laravelPort}, Redis: ${this.redisPort}, Reverb: ${this.reverbPort}`);

            // Step 4: Write runtime .env (production only)
            if (!this.options.isDev) {
                console.log('[Boot] Step 4: Writing runtime environment...');
                this.options.onStatusUpdate('Configuring environment...', 25);
                this.configService.writeRuntimeEnv(this.redisPort, this.reverbPort);
            }

            // Step 5: Start Redis (if enabled)
            if (this.config.services.redis.enabled && this.redisService && !this.config.services.redis.external) {
                console.log('[Boot] Step 5: Starting Redis...');
                this.options.onStatusUpdate('Starting Redis...', 35);
                await this.redisService.start(this.redisPort);
            }

            // Step 6: Start Laravel
            console.log('[Boot] Step 6: Starting Laravel...');
            this.options.onStatusUpdate('Starting Laravel...', 50);
            const laravelEnv = this.configService.getLaravelEnv(this.redisPort, this.reverbPort);
            await this.laravelService.start(this.laravelPort, laravelEnv);

            // Step 7: Wait for Laravel health check
            console.log('[Boot] Step 7: Waiting for Laravel...');
            this.options.onStatusUpdate('Waiting for Laravel...', 65);
            await this.laravelService.waitForReady(this.laravelPort);

            // Step 8: Start Reverb (if enabled)
            if (this.config.services.reverb.enabled && this.reverbService) {
                console.log('[Boot] Step 8: Starting Reverb...');
                this.options.onStatusUpdate('Starting Reverb...', 75);
                const reverbEnv = this.configService.getReverbEnv(this.reverbPort);
                await this.reverbService.start(this.reverbPort, reverbEnv);
            }

            // Step 9: Start Horizon (if enabled and Redis is available)
            if (this.config.services.horizon.enabled && this.horizonService && this.config.services.redis.enabled) {
                console.log('[Boot] Step 9: Starting Horizon...');
                this.options.onStatusUpdate('Starting queue worker...', 85);
                const horizonEnv = this.configService.getHorizonEnv(this.redisPort, this.reverbPort);
                await this.horizonService.start(this.redisPort, horizonEnv);
            }

            // Step 10: Start Scheduler (if enabled, production only)
            if (this.config.services.scheduler.enabled && this.schedulerService && !this.options.isDev) {
                console.log('[Boot] Step 10: Starting Scheduler...');
                this.options.onStatusUpdate('Starting scheduler...', 90);
                const schedulerEnv = this.configService.getLaravelEnv(this.redisPort, this.reverbPort);
                await this.schedulerService.start(schedulerEnv);
            }

            // Step 11: Verify all services
            console.log('[Boot] Step 11: Verifying services...');
            this.options.onStatusUpdate('Verifying services...', 95);
            await this.healthService.verifyAllServices(this.laravelPort, {
                isDev: this.options.isDev,
                redisEnabled: this.config.services.redis.enabled,
            });

            // Step 12: Save PID file
            console.log('[Boot] Step 12: Saving PID file...');
            this.savePidFile();

            console.log('[Boot] Complete!');
            this.options.onStatusUpdate('Ready!', 100);

            return `http://127.0.0.1:${this.laravelPort}`;
        } catch (error) {
            console.error('[Boot] Error:', error);
            this.options.onError(String(error));
            throw error;
        }
    }

    private async checkDatabase(): Promise<void> {
        if (this.config.services.database.driver === 'sqlite') {
            const dbPath = this.configService.databasePath;
            const dbDir = path.dirname(dbPath);

            // Ensure database directory exists
            if (!fs.existsSync(dbDir)) {
                fs.mkdirSync(dbDir, { recursive: true });
            }

            // Create database file if it doesn't exist
            if (!fs.existsSync(dbPath)) {
                fs.writeFileSync(dbPath, '');
                console.log('[Boot] Created SQLite database at:', dbPath);

                // Run migrations for new database
                await this.runMigrations();
            }
        }
    }

    private async runMigrations(): Promise<void> {
        console.log('[Boot] Running migrations...');
        await this.configService.runArtisan(['migrate', '--force']);
    }

    private savePidFile(): void {
        const pidData = {
            laravel: this.laravelService.pid,
            redis: this.redisService?.pid,
            horizon: this.horizonService?.pid,
            reverb: this.reverbService?.pid,
            scheduler: this.schedulerService?.pid,
            ports: {
                laravel: this.laravelPort,
                redis: this.redisPort,
                reverb: this.reverbPort,
            },
            timestamp: Date.now(),
        };

        fs.writeFileSync(
            this.configService.pidFilePath,
            JSON.stringify(pidData, null, 2)
        );
    }

    async shutdown(): Promise<void> {
        console.log('[Boot] Shutting down services...');

        // Shutdown in reverse order
        if (this.schedulerService) {
            await this.schedulerService.stop().catch(console.error);
        }
        if (this.horizonService) {
            await this.horizonService.stop().catch(console.error);
        }
        if (this.reverbService) {
            await this.reverbService.stop().catch(console.error);
        }
        await this.laravelService.stop().catch(console.error);
        if (this.redisService) {
            await this.redisService.stop().catch(console.error);
        }

        // Clean up PID file
        if (fs.existsSync(this.configService.pidFilePath)) {
            fs.unlinkSync(this.configService.pidFilePath);
        }

        console.log('[Boot] Shutdown complete.');
    }
}
