{
    "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
    "appId": "com.example.app",
    "productName": "Laravel App",
    "directories": {
        "output": "dist-electron"
    },
    "files": [
        "electron/dist/**/*",
        "electron/renderer/**/*"
    ],
    "extraResources": [
        {
            "from": "electron/resources/bin/${platform}-${arch}",
            "to": "bin",
            "filter": ["**/*"]
        },
        {
            "from": "app",
            "to": "laravel/app"
        },
        {
            "from": "bootstrap",
            "to": "laravel/bootstrap"
        },
        {
            "from": "config",
            "to": "laravel/config"
        },
        {
            "from": "database/migrations",
            "to": "laravel/database/migrations"
        },
        {
            "from": "database/seeders",
            "to": "laravel/database/seeders"
        },
        {
            "from": "public",
            "to": "laravel/public"
        },
        {
            "from": "resources",
            "to": "laravel/resources"
        },
        {
            "from": "routes",
            "to": "laravel/routes"
        },
        {
            "from": "storage/app/.gitignore",
            "to": "laravel/storage/app/.gitignore"
        },
        {
            "from": "storage/framework/.gitignore",
            "to": "laravel/storage/framework/.gitignore"
        },
        {
            "from": "storage/logs/.gitignore",
            "to": "laravel/storage/logs/.gitignore"
        },
        {
            "from": "vendor",
            "to": "laravel/vendor"
        },
        {
            "from": "artisan",
            "to": "laravel/artisan"
        },
        {
            "from": "composer.json",
            "to": "laravel/composer.json"
        },
        {
            "from": ".env.production",
            "to": "laravel/.env"
        }
    ],
    "mac": {
        "target": [
            {
                "target": "dmg",
                "arch": ["arm64", "x64"]
            },
            {
                "target": "zip",
                "arch": ["arm64", "x64"]
            }
        ],
        "category": "public.app-category.productivity",
        "icon": "electron/resources/icon.icns",
        "hardenedRuntime": true,
        "gatekeeperAssess": false,
        "entitlements": "electron/resources/entitlements.mac.plist",
        "entitlementsInherit": "electron/resources/entitlements.mac.plist"
    },
    "dmg": {
        "contents": [
            {
                "x": 130,
                "y": 220
            },
            {
                "x": 410,
                "y": 220,
                "type": "link",
                "path": "/Applications"
            }
        ]
    },
    "win": {
        "target": [
            {
                "target": "nsis",
                "arch": ["x64"]
            },
            {
                "target": "portable",
                "arch": ["x64"]
            }
        ],
        "icon": "electron/resources/icon.ico"
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "deleteAppDataOnUninstall": true
    },
    "linux": {
        "target": [
            {
                "target": "AppImage",
                "arch": ["x64"]
            }
        ],
        "category": "Utility"
    }
}
