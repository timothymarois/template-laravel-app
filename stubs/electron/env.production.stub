APP_NAME="${ELECTRON_APP_NAME}"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1

# Key will be set at runtime or during build
APP_KEY=

# Database - paths set at runtime by Electron
DB_CONNECTION=sqlite
DB_DATABASE=

# Logging
LOG_CHANNEL=single
LOG_LEVEL=error

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache and Queue - set at runtime
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=

# Broadcasting - set at runtime
BROADCAST_CONNECTION=reverb
REVERB_HOST=127.0.0.1
REVERB_PORT=
REVERB_APP_ID=electron
REVERB_APP_KEY=electron-key
REVERB_APP_SECRET=electron-secret

# Storage - set at runtime by Electron
APP_STORAGE_PATH=

# Disable unnecessary features
TELESCOPE_ENABLED=false
