<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loading...</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #fff;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            -webkit-app-region: drag;
            user-select: none;
        }

        .container {
            text-align: center;
            padding: 40px;
        }

        .logo {
            width: 80px;
            height: 80px;
            margin-bottom: 24px;
            animation: pulse 2s ease-in-out infinite;
        }

        .logo svg {
            width: 100%;
            height: 100%;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
        }

        .status {
            font-size: 14px;
            color: #a0aec0;
            margin-bottom: 16px;
            min-height: 20px;
        }

        .progress-container {
            width: 200px;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #4f46e5, #7c3aed);
            border-radius: 2px;
            transition: width 0.3s ease;
            width: 0%;
        }

        .error-container {
            display: none;
            padding: 16px;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 8px;
            margin-bottom: 16px;
            max-width: 300px;
        }

        .error-container.visible {
            display: block;
        }

        .error-message {
            font-size: 12px;
            color: #fca5a5;
            word-break: break-word;
        }

        .buttons {
            display: none;
            gap: 12px;
            -webkit-app-region: no-drag;
        }

        .buttons.visible {
            display: flex;
        }

        button {
            -webkit-app-region: no-drag;
            padding: 8px 20px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: #4f46e5;
            color: #fff;
        }

        .btn-primary:hover {
            background: #4338ca;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .abort-btn {
            -webkit-app-region: no-drag;
            position: absolute;
            bottom: 16px;
            right: 16px;
            padding: 4px 12px;
            font-size: 11px;
            background: transparent;
            color: #64748b;
            border: 1px solid #334155;
        }

        .abort-btn:hover {
            color: #94a3b8;
            border-color: #475569;
        }

        .abort-btn.hidden {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">
            <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="45" stroke="#4f46e5" stroke-width="3" fill="none"/>
                <path d="M35 50 L45 60 L65 40" stroke="#4f46e5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
        </div>

        <div id="status" class="status">Initializing...</div>

        <div class="progress-container">
            <div id="progress" class="progress-bar"></div>
        </div>

        <div id="error-container" class="error-container">
            <div id="error-message" class="error-message"></div>
        </div>

        <div id="buttons" class="buttons">
            <button class="btn-secondary" onclick="quit()">Quit</button>
            <button class="btn-primary" onclick="retry()">Retry</button>
        </div>
    </div>

    <button id="abort-btn" class="abort-btn" onclick="quit()">Abort</button>

    <script>
        const statusEl = document.getElementById('status');
        const progressEl = document.getElementById('progress');
        const errorContainer = document.getElementById('error-container');
        const errorMessage = document.getElementById('error-message');
        const buttons = document.getElementById('buttons');
        const abortBtn = document.getElementById('abort-btn');

        // Listen for boot status updates
        window.loadingAPI.onBootStatus(({ status, progress }) => {
            statusEl.textContent = status;
            progressEl.style.width = `${progress}%`;
        });

        // Listen for boot errors
        window.loadingAPI.onBootError(({ error }) => {
            statusEl.textContent = 'Boot failed';
            errorContainer.classList.add('visible');
            errorMessage.textContent = error;
            buttons.classList.add('visible');
            abortBtn.classList.add('hidden');
        });

        // Retry boot
        async function retry() {
            errorContainer.classList.remove('visible');
            buttons.classList.remove('visible');
            abortBtn.classList.remove('hidden');
            statusEl.textContent = 'Retrying...';
            progressEl.style.width = '0%';

            const result = await window.loadingAPI.retryBoot();
            if (!result.success) {
                errorContainer.classList.add('visible');
                errorMessage.textContent = result.error || 'Unknown error';
                buttons.classList.add('visible');
                abortBtn.classList.add('hidden');
            }
        }

        // Quit app
        function quit() {
            window.loadingAPI.quitApp();
        }
    </script>
</body>
</html>
