<template>
    <LayoutDefault title="Select Tenant">
        <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-md">
            <Card>
                <template #header>
                    <div class="font-semibold text-gray-900 dark:text-gray-100 text-md flex items-center space-x-2">
                        <div>Select a Workspace</div>
                    </div>
                </template>
                <template #content>
                    <div class="space-y-3">
                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                            Choose a workspace to continue:
                        </p>
                        <div v-if="tenants.length === 0" class="text-center py-8 text-gray-500">
                            No workspaces found. Please contact support.
                        </div>
                        <div v-else class="space-y-2">
                            <button
                                v-for="tenant in tenants"
                                :key="tenant.id"
                                @click="selectTenant(tenant)"
                                :disabled="!tenant.ready || processing"
                                class="w-full p-4 text-left border rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                :class="{
                                    'border-gray-200 dark:border-gray-700': tenant.ready,
                                    'border-yellow-300 dark:border-yellow-700 bg-yellow-50 dark:bg-yellow-900/20': !tenant.ready
                                }"
                            >
                                <div class="flex items-center justify-between">
                                    <div>
                                        <div class="font-medium text-gray-900 dark:text-gray-100">
                                            {{ tenant.company_name }}
                                        </div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">
                                            {{ tenant.domain }}.{{ appDomain }}
                                        </div>
                                    </div>
                                    <div v-if="!tenant.ready" class="text-xs text-yellow-600 dark:text-yellow-400">
                                        Setting up...
                                    </div>
                                    <div v-else class="text-gray-400">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>
                </template>
                <template #footer>
                    <div class="w-full flex flex-col space-y-4">
                        <FormErrors :errors="errors" />
                        <div class="text-center text-sm text-gray-500">
                            <Link :href="route('auth.logout')" class="hover:underline">
                                Logout
                            </Link>
                        </div>
                    </div>
                </template>
            </Card>
        </div>
    </LayoutDefault>
</template>

<script setup>
import { inject, ref } from 'vue';
import { Link } from '@inertiajs/vue3';
import axios from 'axios';
import { SiteLayout as LayoutDefault } from '@/components/site';
import { Card, FormErrors } from '@/components/ui';

const route = inject('route');

const props = defineProps({
    tenants: {
        type: Array,
        default: () => [],
    },
    appDomain: {
        type: String,
        default: 'localhost',
    },
});

const processing = ref(false);
const errors = ref({});

const selectTenant = async (tenant) => {
    if (!tenant.ready || processing.value) return;

    processing.value = true;
    errors.value = {};

    try {
        const response = await axios.post(route('tenants.select'), {
            tenant_id: tenant.id,
        });

        if (response.data.redirect_url) {
            // Full page navigation to tenant subdomain
            window.location.href = response.data.redirect_url;
        }
    } catch (error) {
        processing.value = false;
        if (error.response?.data?.error) {
            errors.value = { tenant: error.response.data.error };
        } else {
            errors.value = { tenant: 'Failed to select workspace. Please try again.' };
        }
    }
};
</script>
