<?php

declare(strict_types=1);

namespace App\Http\Controllers;

use App\Models\Tenant;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Inertia\Response;
use Inertia\ResponseFactory;

class TenantController extends Controller
{
    public function __construct(
        protected ResponseFactory $inertia,
    ) {}

    /**
     * Display the tenant selection page.
     */
    public function index(): Response
    {
        /** @var \App\Models\CentralUser $user */
        $user = auth()->user();

        $tenants = $user->tenants()
            ->with('domains')
            ->get()
            ->map(fn (Tenant $tenant) => [
                'id' => $tenant->id,
                'company_name' => $tenant->company_name,
                'domain' => $tenant->domains->first()?->domain,
                'ready' => $tenant->ready,
                'created_at' => $tenant->created_at->toDateTimeString(),
            ]);

        return $this->inertia->render('tenants/Index', [
            'tenants' => $tenants,
            'appDomain' => config('tenancy.central_domains.0', env('APP_DOMAIN', 'localhost')),
        ]);
    }

    /**
     * Select a tenant and return the redirect URL.
     *
     * Returns JSON with the tenant URL for client-side redirect,
     * since Inertia/AJAX can't follow cross-domain redirects.
     */
    public function select(Request $request): JsonResponse
    {
        $request->validate([
            'tenant_id' => ['required', 'string'],
        ]);

        /** @var \App\Models\CentralUser $user */
        $user = auth()->user();

        $tenant = $user->tenants()
            ->where('tenants.id', $request->input('tenant_id'))
            ->with('domains')
            ->first();

        if (! $tenant) {
            return response()->json([
                'error' => 'Tenant not found or you do not have access.',
            ], 422);
        }

        if (! $tenant->ready) {
            return response()->json([
                'error' => 'Tenant is still being provisioned. Please wait.',
            ], 422);
        }

        $domain = $tenant->domains->first();

        if (! $domain) {
            return response()->json([
                'error' => 'Tenant does not have a domain configured.',
            ], 422);
        }

        // Build the tenant URL
        $appDomain = config('tenancy.central_domains.0', env('APP_DOMAIN', 'localhost'));
        $protocol = request()->secure() ? 'https' : 'http';
        $tenantUrl = "{$protocol}://{$domain->domain}.{$appDomain}";

        return response()->json([
            'redirect_url' => $tenantUrl,
        ]);
    }
}
