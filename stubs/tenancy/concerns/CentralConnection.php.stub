<?php

declare(strict_types=1);

namespace App\Models\Concerns;

use Illuminate\Support\Facades\Config;

/**
 * Forces a model to always use the central database connection.
 *
 * Use this trait on models that should always query the central (landlord)
 * database, regardless of the current tenant context.
 */
trait CentralConnection
{
    /**
     * Get the current connection name for the model.
     */
    public function getConnectionName(): ?string
    {
        return Config::get('tenancy.database.central_connection');
    }
}
