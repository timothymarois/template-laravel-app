<?php

/**
 * Tenant selection routes.
 *
 * These routes handle tenant selection on the central domain.
 * They are automatically loaded when tenancy is configured.
 */

use App\Http\Controllers\TenantController;
use Illuminate\Support\Facades\Route;

Route::middleware(['web', 'auth:sanctum'])->group(function () {
    Route::get('tenants', [TenantController::class, 'index'])->name('tenants.index');
    Route::post('tenants/select', [TenantController::class, 'select'])->name('tenants.select');
});
