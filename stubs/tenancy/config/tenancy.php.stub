<?php

declare(strict_types=1);

use Stancl\Tenancy\Bootstrappers;
use Stancl\Tenancy\Database\Models;

return [
    /*
    |--------------------------------------------------------------------------
    | Tenancy Enabled
    |--------------------------------------------------------------------------
    |
    | This option controls whether tenancy features are enabled. Set to false
    | to disable all tenancy functionality without removing configuration.
    |
    */
    'enabled' => env('TENANCY_ENABLED', true),

    /*
    |--------------------------------------------------------------------------
    | Tenant Model
    |--------------------------------------------------------------------------
    |
    | The model used to represent tenants in your application.
    |
    */
    'tenant_model' => App\Models\Tenant::class,

    /*
    |--------------------------------------------------------------------------
    | Domain Model
    |--------------------------------------------------------------------------
    |
    | The model used to represent tenant domains.
    |
    */
    'domain_model' => App\Models\Domain::class,

    /*
    |--------------------------------------------------------------------------
    | Tenant ID Generator
    |--------------------------------------------------------------------------
    |
    | The class used to generate unique IDs for new tenants.
    | Options: UUIDGenerator, RandomHexGenerator, or custom implementation.
    |
    */
    'id_generator' => Stancl\Tenancy\UUIDGenerator::class,

    /*
    |--------------------------------------------------------------------------
    | Central Domains
    |--------------------------------------------------------------------------
    |
    | Domains that should be treated as "central" (landlord) domains.
    | Requests to these domains will not initialize any tenant.
    |
    */
    'central_domains' => [
        env('APP_DOMAIN', 'localhost'),
    ],

    /*
    |--------------------------------------------------------------------------
    | Bootstrappers
    |--------------------------------------------------------------------------
    |
    | Bootstrappers are classes that set up the tenant environment.
    | They run when tenancy is initialized and can modify config, connections, etc.
    |
    */
    'bootstrappers' => [
        Bootstrappers\DatabaseTenancyBootstrapper::class,
        Bootstrappers\CacheTenancyBootstrapper::class,
        Bootstrappers\FilesystemTenancyBootstrapper::class,
        Bootstrappers\QueueTenancyBootstrapper::class,
    ],

    /*
    |--------------------------------------------------------------------------
    | Database Configuration
    |--------------------------------------------------------------------------
    |
    | Configuration for tenant database management.
    |
    */
    'database' => [
        /*
        |--------------------------------------------------------------------------
        | Central Connection
        |--------------------------------------------------------------------------
        |
        | The database connection used for the central (landlord) database.
        | This stores tenants, domains, and other central application data.
        |
        */
        'central_connection' => env('DB_CONNECTION', 'mysql'),

        /*
        |--------------------------------------------------------------------------
        | Template Tenant Connection
        |--------------------------------------------------------------------------
        |
        | The connection template used for creating tenant database connections.
        | If null, uses the central connection as template.
        |
        */
        'template_tenant_connection' => null,

        /*
        |--------------------------------------------------------------------------
        | Database Prefix
        |--------------------------------------------------------------------------
        |
        | Prefix added to tenant database names.
        | Example: 'tenant_' results in databases named 'tenant_abc123'
        |
        */
        'prefix' => env('TENANCY_DB_PREFIX', 'tenant_'),

        /*
        |--------------------------------------------------------------------------
        | Database Suffix
        |--------------------------------------------------------------------------
        |
        | Suffix added to tenant database names.
        |
        */
        'suffix' => '',

        /*
        |--------------------------------------------------------------------------
        | Database Managers
        |--------------------------------------------------------------------------
        |
        | Classes that handle database creation/deletion for different drivers.
        |
        */
        'managers' => [
            'sqlite' => Stancl\Tenancy\TenantDatabaseManagers\SQLiteDatabaseManager::class,
            'mysql' => Stancl\Tenancy\TenantDatabaseManagers\MySQLDatabaseManager::class,
            'pgsql' => Stancl\Tenancy\TenantDatabaseManagers\PostgreSQLDatabaseManager::class,
        ],
    ],

    /*
    |--------------------------------------------------------------------------
    | Migration Parameters
    |--------------------------------------------------------------------------
    |
    | Parameters passed to the migrate command when creating tenant databases.
    |
    */
    'migration_parameters' => [
        '--force' => true,
        '--path' => [database_path('migrations/tenant')],
        '--realpath' => true,
    ],

    /*
    |--------------------------------------------------------------------------
    | Seeder Parameters
    |--------------------------------------------------------------------------
    |
    | Parameters passed to the db:seed command when seeding tenant databases.
    |
    */
    'seeder_parameters' => [
        '--class' => 'Database\Seeders\TenantDatabaseSeeder',
        '--force' => true,
    ],

    /*
    |--------------------------------------------------------------------------
    | Queue Tenant Creation
    |--------------------------------------------------------------------------
    |
    | Whether to queue tenant database creation jobs. Set to true in production
