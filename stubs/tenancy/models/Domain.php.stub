<?php

declare(strict_types=1);

namespace App\Models;

use Illuminate\Support\Facades\Cache;
use Stancl\Tenancy\Database\Models\Domain as BaseDomain;

/**
 * @property int $id
 * @property string $domain
 * @property string $tenant_id
 * @property \Illuminate\Support\Carbon|null $created_at
 * @property \Illuminate\Support\Carbon|null $updated_at
 * @property-read Tenant $tenant
 */
class Domain extends BaseDomain
{
    /**
     * Bootstrap the model.
     */
    protected static function booted(): void
    {
        // Clear domain cache when domains are modified
        static::saved(fn () => Cache::forget('tenant_domain_' . tenant()?->id));
        static::updated(fn () => Cache::forget('tenant_domain_' . tenant()?->id));
        static::deleted(fn () => Cache::forget('tenant_domain_' . tenant()?->id));
    }
}
