<?php

declare(strict_types=1);

namespace App\Models;

use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\BelongsToMany;
use Illuminate\Database\Eloquent\SoftDeletes;
use Stancl\Tenancy\Contracts\TenantWithDatabase;
use Stancl\Tenancy\Database\Concerns\HasDatabase;
use Stancl\Tenancy\Database\Concerns\HasDomains;
use Stancl\Tenancy\Database\Models\Tenant as BaseTenant;

/**
 * @property string $id
 * @property int|null $owner_user_id
 * @property string $company_name
 * @property string|null $timezone
 * @property bool $ready
 * @property array|null $data
 * @property \Illuminate\Support\Carbon|null $created_at
 * @property \Illuminate\Support\Carbon|null $updated_at
 * @property \Illuminate\Support\Carbon|null $deleted_at
 * @property-read CentralUser|null $ownerUser
 * @property-read \Illuminate\Database\Eloquent\Collection<int, CentralUser> $users
 * @property-read \Illuminate\Database\Eloquent\Collection<int, Domain> $domains
 */
class Tenant extends BaseTenant implements TenantWithDatabase
{
    use HasDatabase, HasDomains, SoftDeletes;

    /**
     * The attributes that are mass assignable.
     *
     * @var list<string>
     */
    protected $fillable = [
        'owner_user_id',
        'company_name',
        'timezone',
        'ready',
    ];

    /**
     * Get the columns that should be stored in the tenant's own row.
     *
     * @return list<string>
     */
    public static function getCustomColumns(): array
    {
        return [
            'id',
            'owner_user_id',
            'company_name',
            'timezone',
            'ready',
            'created_at',
            'updated_at',
            'deleted_at',
        ];
    }

    /**
     * Get the attributes that should be cast.
     *
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'ready' => 'boolean',
        ];
    }

    /**
     * Get the owner of this tenant.
     */
    public function ownerUser(): BelongsTo
    {
        return $this->belongsTo(CentralUser::class, 'owner_user_id');
    }

    /**
     * Get the central users that belong to this tenant.
     */
    public function users(): BelongsToMany
    {
        return $this->belongsToMany(CentralUser::class, 'tenant_user', 'tenant_id', 'user_id')
            ->using(TenantUser::class)
            ->withPivot('is_active')
            ->withTimestamps();
    }
}
