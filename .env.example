APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_DOMAIN=template-laravel-app.test
APP_URL="https://${APP_DOMAIN}"
INERTIA_SSR_ENABLED=true
INERTIA_SSR_PORT=13714
INERTIA_SSR_HOST=127.0.0.1
INERTIA_SSR_URL="http://${INERTIA_SSR_HOST}:${INERTIA_SSR_PORT}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=template
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Set to true to enable WebSocket connections (requires running: php artisan reverb:start)
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Cache: Use "database" for local, "redis" for production
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELESCOPE_ENABLED=false

# Admin tool access (comma-separated emails)
HORIZON_ALLOWED_EMAILS=

# CORS (comma-separated origins for production)
# CORS_ALLOWED_ORIGINS=https://example.com

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# ====================================================================
# Optional: Multi-tenancy
# ====================================================================
# Tenancy ships installed but inert. If you're starting a new project
# and don't need multi-tenancy, leave everything below as-is — the app
# behaves exactly as it would without tenancy code in the repo.
#
# To enable tenancy: run `php artisan tenancy:enable`. See
# docs/guidelines/tenancy-using.md for the full setup walkthrough.
# ====================================================================
TENANCY_ENABLED=false
TENANCY_IDENTIFICATION=path
TENANCY_CENTRAL_DOMAINS=

# Grace window (hours) before `tenancy:purge-deleted` force-deletes a
# soft-deleted tenant + drops its database. Default 72.
TENANCY_PURGE_DELETED_AFTER_HOURS=72

# Central DB connection — only consumed when tenancy is enabled.
DB_CENTRAL_CONNECTION=pgsql_central
DB_CENTRAL_HOST=
DB_CENTRAL_PORT=
DB_CENTRAL_DATABASE=
DB_CENTRAL_USERNAME=
DB_CENTRAL_PASSWORD=

# Google Analytics (gtag.js) — set to your GA4 measurement id (e.g. G-XXXXXXXXXX) to enable.
# Leave empty in local/staging to suppress and avoid polluting production analytics.
GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN_PUBLIC="${SENTRY_LARAVEL_DSN}"
