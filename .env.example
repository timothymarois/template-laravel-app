APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_DOMAIN=template-laravel-app.test
APP_URL="https://${APP_DOMAIN}"
INERTIA_SSR_ENABLED=true
INERTIA_SSR_PORT=13714
INERTIA_SSR_HOST=127.0.0.1
INERTIA_SSR_URL="http://${INERTIA_SSR_HOST}:${INERTIA_SSR_PORT}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# In production (LOG_CHANNEL=stderr) logs are one-line JSON by default for log shippers.
# Uncomment for human-readable lines instead:
# LOG_STDERR_FORMATTER=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=template
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Set to true to enable WebSocket connections (requires running: php artisan reverb:start)
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Cache: Redis (matches the mandatory stack — Herd ships Redis locally, prod via Coolify)
CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` writes every message to storage/logs/laravel.log instead of sending
# it — password-reset links included. Open the log and copy the URL out of it.
# For a real inbox locally set MAIL_MAILER=smtp: the host/port below already point
# at the standard local catcher (Herd Pro's mail service / Mailpit). In production
# set a real provider and fill the credentials — a fork that ships `log` has a
# password-reset flow that silently does nothing.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELESCOPE_ENABLED=false

# Admin tool access (comma-separated emails)
HORIZON_ALLOWED_EMAILS=

# CORS (comma-separated origins for production)
# CORS_ALLOWED_ORIGINS=https://example.com

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# ====================================================================
# Health checks (spatie/laravel-health) — see docs/concepts/health-checks.md
# ====================================================================
# Results store in the default cache (override the store with HEALTH_CACHE_STORE).
# Notifications are OFF by default (Sentry already covers errors); set to true and
# fill HEALTH_TO_ADDRESS (mail) or HEALTH_SLACK_WEBHOOK_URL to get alerts on failure.
HEALTH_NOTIFICATIONS_ENABLED=false
# HEALTH_CACHE_STORE=
# A channel fires only when its target below is set (and notifications enabled):
# HEALTH_TO_ADDRESS=
# HEALTH_DISCORD_WEBHOOK_URL=
# HEALTH_SLACK_WEBHOOK_URL=
# Protect the public /health endpoint by requiring an X-Secret-Token header:
# HEALTH_SECRET_TOKEN=

# API keys. The prefix is stamped on every issued key so secret scanners (GitHub's
# included) can recognise a leaked one on sight. Change it to something unique to
# your product; changing it does NOT invalidate keys already issued.
SANCTUM_TOKEN_PREFIX=apik_

# Google Analytics (gtag.js) — set to your GA4 measurement id (e.g. G-XXXXXXXXXX) to enable.
# Leave empty in local/staging to suppress and avoid polluting production analytics.
GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN_PUBLIC="${SENTRY_LARAVEL_DSN}"
